typeset -U path
path=($HOME/.local/bin $path)

HISTFILE=~/.history
HISTSIZE=50000
SAVEHIST=50000
setopt inc_append_history share_history hist_ignore_dups hist_ignore_space extended_history hist_expire_dups_first hist_verify
setopt auto_cd auto_pushd pushd_ignore_dups pushd_minus interactive_comments no_beep no_flow_control long_list_jobs
setopt complete_in_word always_to_end

export EDITOR=nvim
export SUDO_EDITOR=$EDITOR
export PAGER=less
export LESS=-R

{{ if eq .chezmoi.os "darwin" -}}
export CLICOLOR=1
export LSCOLORS=Gxfxcxdxbxegedabagacad
alias ls='ls -G'
{{- else -}}
eval "$(dircolors -b)"
alias ls='ls --color=auto'
{{- end }}
alias l='ls -lah'
alias la='ls -lAh'
alias ll='ls -lh'
alias grep='grep --color=auto'

bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search edit-command-line
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zle -N edit-command-line
bindkey '^[[A' up-line-or-beginning-search '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search '^[OB' down-line-or-beginning-search
bindkey '^[[H' beginning-of-line '^[OH' beginning-of-line '^[[F' end-of-line '^[OF' end-of-line
bindkey '^[[1;5C' forward-word '^[[1;5D' backward-word
bindkey '^[[3~' delete-char '^[[3;5~' kill-word
bindkey '^[[Z' reverse-menu-complete
bindkey ' ' magic-space
bindkey '^X^E' edit-command-line

autoload -Uz compinit && compinit -d ~/.cache/zcompdump
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path ~/.cache/zsh
zstyle ':completion:*:cd:*' tag-order local-directories directory-stack path-directories

(( $+commands[fzf] )) && source <(fzf --zsh)

for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
  for dir in /usr/share/$plugin /opt/homebrew/share/$plugin; do
    [[ -r $dir/$plugin.zsh ]] && { source $dir/$plugin.zsh; break; }
  done
done

zmodload zsh/datetime
autoload -Uz add-zsh-hook

prompt_git_state() {
  local git_dir=$1 state= step= total=
  if [[ -d $git_dir/rebase-merge ]]; then
    state=REBASING step=$(<$git_dir/rebase-merge/msgnum) total=$(<$git_dir/rebase-merge/end)
  elif [[ -d $git_dir/rebase-apply ]]; then
    state=REBASING step=$(<$git_dir/rebase-apply/next) total=$(<$git_dir/rebase-apply/last)
  elif [[ -f $git_dir/MERGE_HEAD ]]; then state=MERGING
  elif [[ -f $git_dir/CHERRY_PICK_HEAD ]]; then state=CHERRY-PICKING
  elif [[ -f $git_dir/REVERT_HEAD ]]; then state=REVERTING
  elif [[ -f $git_dir/BISECT_LOG ]]; then state=BISECTING
  fi
  [[ -n $state ]] && print -rn -- "%F{yellow}$state${total:+ $step/$total}%f "
}

prompt_duration() {
  local -i ms=$1
  (( ms < 3000 )) && return
  local -i s=$(( ms / 1000 ))
  local -i h=$(( s / 3600 )) m=$(( s % 3600 / 60 ))
  local text=
  (( h )) && text+="${h}h"
  (( h || m )) && text+="${m}m"
  text+="$(( s % 60 ))s"
  print -rn -- "%F{8}$text%f "
}

prompt_preexec() { prompt_started=$EPOCHREALTIME }

prompt_precmd() {
  local -a git_info=("${(@f)$(git rev-parse --show-toplevel --absolute-git-dir 2>/dev/null)}")
  local dir
  if [[ -n $git_info[1] ]]; then
    dir=${git_info[1]:t}${PWD#$git_info[1]}
    dir=${dir//\%/%%}
  else
    dir='%3~'
  fi
  local -i ms=0
  [[ -n $prompt_started ]] && ms=$(( (EPOCHREALTIME - prompt_started) * 1000 ))
  unset prompt_started
  PROMPT="%F{blue}$dir%f $( [[ -n $git_info[2] ]] && prompt_git_state $git_info[2] )$(prompt_duration $ms)%(?.%F{magenta}.%F{red})❯%f "
}

add-zsh-hook preexec prompt_preexec
add-zsh-hook precmd prompt_precmd

{{ template "zshrc-aliases" . }}
if [[ -r ~/.zshrc.local ]]; then source ~/.zshrc.local; fi
